// Indradhanu — Dynamic Replanning Loop
// Render: dot -Tsvg 04-dynamic-replanning.dot -o 04-dynamic-replanning.svg   (or -Tpng)
digraph G {
  label=<<font point-size="20"><b>Indradhanu — Dynamic Replanning Loop</b></font>>;
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", pad=0.4, nodesep=0.35, ranksep=0.55,
         newrank=true, compound=true, labelloc=t, labeljust=l];
  node  [fontname="Helvetica", shape=plain];
  edge  [fontname="Helvetica", fontsize=9, color="#475569", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
  subgraph cluster_trig {
    label=<<b>Anything that changes the world</b>>; fontsize=13; style="rounded"; color="#CBD5E1"; bgcolor="#FFFFFF"; margin=14;
    t_new [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#9A5B13" bgcolor="white"><tr><td bgcolor="#9A5B13" align="left"><font color="white"><b>New incident</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• citizen SOS, camera alarm<br align="left"/></font></td></tr></table>>];
    t_block [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#1D6B47" bgcolor="white"><tr><td bgcolor="#1D6B47" align="left"><font color="white"><b>Road blocked</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• crew report over mesh or app<br align="left"/></font></td></tr></table>>];
    t_unit [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#1D6B47" bgcolor="white"><tr><td bgcolor="#1D6B47" align="left"><font color="white"><b>Unit unavailable</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• breakdown, crew status<br align="left"/></font></td></tr></table>>];
    t_off [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#9A5B13" bgcolor="white"><tr><td bgcolor="#9A5B13" align="left"><font color="white"><b>Officer override</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• cancel, hold, pin, forbid<br align="left"/></font></td></tr></table>>];
    t_haz [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#5B6470" bgcolor="white"><tr><td bgcolor="#5B6470" align="left"><font color="white"><b>Hazard update</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• risk or forecast change<br align="left"/></font></td></tr></table>>];
    { rank=same; t_new; t_block; t_unit; t_off; t_haz; }
  }
  r_router [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#374151" bgcolor="white"><tr><td bgcolor="#374151" align="left"><font color="white"><b>Event Router (always on)</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• debounce per ward<br align="left"/>• wake the re-planner<br align="left"/>• wake the Commander if severe<br align="left"/></font></td></tr></table>>];
  r_solver [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#0E5E6F" bgcolor="white"><tr><td bgcolor="#0E5E6F" align="left"><font color="white"><b>Re-planner (CP-SAT, ≤ 4 s)</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• rebuild demand and fleet<br align="left"/>• travel times around blocks<br align="left"/>• lock pinned / on-scene units<br align="left"/>• switch only if it saves enough<br align="left"/></font></td></tr></table>>];
  r_cmd [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#4C3D8F" bgcolor="white"><tr><td bgcolor="#4C3D8F" align="left"><font color="white"><b>Incident Commander (LLM)</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• read the situation<br align="left"/>• simulate alternatives<br align="left"/>• propose extra actions<br align="left"/></font></td></tr></table>>];
  r_gate [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#7A2E2E" bgcolor="white"><tr><td bgcolor="#7A2E2E" align="left"><font color="white"><b>Policy Gate</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• auto or officer approval<br align="left"/></font></td></tr></table>>];
  r_diff [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#0E5E6F" bgcolor="white"><tr><td bgcolor="#0E5E6F" align="left"><font color="white"><b>Plan diff</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• kept · reassigned · new<br align="left"/>• released · uncovered<br align="left"/></font></td></tr></table>>];
  r_out [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#1F4E79" bgcolor="white"><tr><td bgcolor="#1F4E79" align="left"><font color="white"><b>Dispatch outbox</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• priority queue of messages<br align="left"/></font></td></tr></table>>];
  r_crew [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#1D6B47" bgcolor="white"><tr><td bgcolor="#1D6B47" align="left"><font color="white"><b>Crew phones</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• new job or new route<br align="left"/>• over app or mesh<br align="left"/></font></td></tr></table>>];
  r_status [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="6" color="#1D6B47" bgcolor="white"><tr><td bgcolor="#1D6B47" align="left"><font color="white"><b>Crew reports back</b></font></td></tr><tr><td align="left"><font point-size="10" color="#1F2937">• accepted, on site, done<br align="left"/>• road blocked<br align="left"/></font></td></tr></table>>];
  t_new -> r_router;
  t_block -> r_router;
  t_unit -> r_router;
  t_off -> r_router;
  t_haz -> r_router;
  r_router -> r_solver [penwidth=2];
  r_router -> r_cmd [style=dashed, label=" severe only"];
  r_cmd -> r_gate -> r_solver [label=" approved action"];
  r_solver -> r_diff -> r_out -> r_crew -> r_status;
  r_status -> r_router [label=" loop: the plan keeps adapting", color="#0E5E6F", penwidth=2, constraint=false];
}
