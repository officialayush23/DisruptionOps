# ---- environment ----
# One of: development | staging | production
INDRADHANU_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Where the PWA is served, for the BiChat phone app's online mode. The app adds
# /citizen (residents) or /field (crews and staff) by the signed-in role.
# Empty: the first non-localhost CORS origin.
PUBLIC_APP_URL=https://distro-ruddy.vercel.app

# Development only. When set, an unauthenticated request is treated as this
# role instead of as an anonymous citizen, so the API can be exercised before a
# Supabase user exists. The app refuses to start if this is set while
# INDRADHANU_ENV is anything other than `development`.
# One of: citizen | field_operator | ward_officer | commissioner | admin
DEV_AUTH_ROLE=

# ---- database (Supabase) ----
SUPABASE_URL=
SUPABASE_ANON_PUBLIC_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_KEY=
# Session pooler for the API; direct connection for migrations/seeding.
SUPABASE_TRANSACTION_POOLER=
SUPABASE_DIRECT_CONNECTION_STRING=
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---- llm ----
# development -> gemini, production -> bedrock. Falls back to deterministic
# rules whenever the provider errors or the quota is exhausted.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AWS_REGION=ap-south-1
# A Bedrock API key (starts ABSK). Exported as AWS_BEARER_TOKEN_BEDROCK.
AWS_API_KEY_BEDROCK_FOR_XAI=
BEDROCK_MODEL_ID=

# ---- routing ----
# Mapbox is the preferred router. It returns turn instructions carrying street
# names, which is the difference between "go 2.1 km north" and "left onto Karve
# Road", and the public OSRM demo server refuses the Matrix sizes the allocator
# asks for. Same token the frontend map uses. Without it: OSRM, then
# straight lines, and the response says which engine answered.
MAPBOX_TOKEN=
OSRM_URL=https://router.project-osrm.org

# ---- speech ----
# Sarvam AI, for speech to text. Trained on Indian languages including the
# code-mixed speech people actually use. Without it the voice report button
# fails and typing still works.
SARVAM_AI_API_KEY=

# ---- report classification ----
# Hugging Face Inference API, for the multilingual zero-shot classifier that
# backs the report parser when its keyword pass is not confident. Without it
# the keyword pass decides alone.
HF_API_TOKEN=

# ---- vision ----
# A vision model hosted elsewhere; the contract is in docs/VLM_CONTRACT.md.
# Empty means photos are accepted and simply not looked at, which is a fine
# state to ship in.
VLM_URL=
VLM_API_KEY=
VLM_MODEL=

# ---- offline mesh (bitchat) ----
# Shared secret a gateway phone, scripts/mesh_bridge.py or a camera node sends
# as X-Mesh-Gateway-Key. Empty disables /mesh/* and /ingest/sensor (403).
MESH_GATEWAY_KEY=
# Signs IDX1 packets (camera node, bridge). Empty = accept unsigned, score lower.
MESH_HMAC_KEY=

# ---- upstream feeds ----
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# Google Flood Hub, if you have a key. Without one the flood forecast comes
# from GloFAS through Open-Meteo, which needs no key.
GOOGLE_FLOOD_HUB_KEY=
NASA_FIRMS_KEY=
DATA_GOV_IN_KEY=
FEED_TIMEOUT_SECONDS=12
FEED_CACHE_TTL_SECONDS=900


# ---- llm cost controls (app/agents/llm_cost.py) ----
# A cheaper model for routing/category/severity/duplicate yes-no. Empty = main model.
GEMINI_MODEL_SMALL=
BEDROCK_MODEL_ID_SMALL=
BEDROCK_PROMPT_CACHE=false
LLM_TOKENS_PER_MINUTE=300000
LLM_TOKENS_PER_DAY=20000000
LLM_MAX_CONCURRENCY=32
LLM_CACHE_ENABLED=true
# USD per 1M tokens, model=in/out. Unknown models report tokens only.
LLM_PRICES=gemini-2.5-flash=0.30/2.50,gemini-2.5-flash-lite=0.10/0.40

# ---- scale (docs/PRODUCTION_HARDENING.md) ----
# Shared state for more than one replica. Empty = in-process (one replica).
REDIS_URL=
ACCESS_LOG_SAMPLE=1.0
INGEST_WORKERS=4
INGEST_BATCH_SIZE=500
INGEST_FLUSH_MS=50
ROUTER_LEASE_S=15
