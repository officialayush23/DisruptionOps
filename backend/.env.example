# ---- environment ----
# One of: development | staging | production
INDRADHANU_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Development only. When set, an unauthenticated request is treated as this
# role instead of as an anonymous citizen, so the API can be exercised before a
# Supabase user exists. The app refuses to start if this is set while
# INDRADHANU_ENV is anything other than `development`.
# One of: citizen | field_operator | ward_officer | commissioner | admin
DEV_AUTH_ROLE=

# ---- database (Supabase) ----
SUPABASE_URL=
SUPABASE_ANON_PUBLIC_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_KEY=
# Session pooler for the API; direct connection for migrations/seeding.
SUPABASE_TRANSACTION_POOLER=
SUPABASE_DIRECT_CONNECTION_STRING=
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---- llm ----
# development -> gemini, production -> bedrock. Falls back to deterministic
# rules whenever the provider errors or the quota is exhausted.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AWS_REGION=ap-south-1
# A Bedrock API key (starts ABSK). Exported as AWS_BEARER_TOKEN_BEDROCK.
AWS_API_KEY_BEDROCK_FOR_XAI=
BEDROCK_MODEL_ID=

# ---- upstream feeds ----
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OSRM_URL=https://router.project-osrm.org
NASA_FIRMS_KEY=
DATA_GOV_IN_KEY=
FEED_TIMEOUT_SECONDS=12
FEED_CACHE_TTL_SECONDS=900
